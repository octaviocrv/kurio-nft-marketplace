# Dependências e build
node_modules/
dist/
*.local
*.tsbuildinfo
.eslintcache

# Ambiente (o .env.example vai pro repo, com valores fictícios)
.env
.env.*
!.env.example

# Deploy
.vercel/

# Playwright: saídas de cada execução (regeneradas a cada rodada).
